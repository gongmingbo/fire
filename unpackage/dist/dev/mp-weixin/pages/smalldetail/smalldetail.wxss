.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
.moment-detail {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.moment-detail .user-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.moment-detail .user-info .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.moment-detail .user-info .info {
  flex: 1;
}
.moment-detail .user-info .info .name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}
.moment-detail .user-info .info .time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.moment-detail .content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.moment-detail .image-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -4rpx 16rpx;
}
.moment-detail .image-list image {
  width: calc(33.33% - 8rpx);
  height: 200rpx;
  margin: 4rpx;
  border-radius: 8rpx;
}
.moment-detail .action-bar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.moment-detail .action-bar .action-item {
  display: flex;
  align-items: center;
}
.moment-detail .action-bar .action-item text {
  font-size: 26rpx;
  color: #999;
  margin: 0 8rpx;
}
.moment-detail .action-bar .action-item .like-count.liked, .moment-detail .action-bar .action-item .comment-count.liked {
  color: #ff4d4f;
}
.comment-list {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}
.comment-list .comment-item {
  display: flex;
  margin-bottom: 20rpx;
}
.comment-list .comment-item .avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}
.comment-list .comment-item .comment-content {
  flex: 1;
}
.comment-list .comment-item .comment-content .comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.comment-list .comment-item .comment-content .comment-header .name {
  font-size: 28rpx;
  color: #007AFF;
}
.comment-list .comment-item .comment-content .comment-header .time {
  font-size: 24rpx;
  color: #999;
}
.comment-list .comment-item .comment-content .comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.comment-list .comment-item .comment-content .comment-actions {
  display: flex;
  margin-bottom: 8rpx;
}
.comment-list .comment-item .comment-content .comment-actions .action {
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}
.comment-list .comment-item .comment-content .reply-list {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 12rpx;
}
.comment-list .comment-item .comment-content .reply-list .reply-item {
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.comment-list .comment-item .comment-content .reply-list .reply-item .name {
  color: #007AFF;
}
.comment-list .comment-item .comment-content .reply-list .reply-item .reply-to {
  color: #666;
  margin: 0 8rpx;
}
.comment-list .comment-item .comment-content .reply-list .reply-item .content {
  color: #333;
}
.comment-input {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 999;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.comment-input input {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}
.comment-input .submit-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  background-color: #007AFF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
}
.reply-input {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}
.reply-input input {
  flex: 1;
  height: 60rpx;
  background-color: #fff;
  border-radius: 30rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}
.reply-input .submit-btn {
  width: 100rpx;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #007AFF;
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
}