.container {
  min-height: 100vh;
  background-color: #f5f6fa;
  padding: 20rpx;
}
.container .picker-view {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.container .info-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}
.container .info-card .info-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  align-items: center;
}
.container .info-card .info-item:last-child {
  border-bottom: none;
}
.container .info-card .info-item .info-label {
  color: #666;
  font-size: 28rpx;
}
.container .info-card .info-item .input-container {
  display: flex;
  align-items: center;
  width: 60%;
  justify-content: flex-end;
}
.container .info-card .info-item .input-container .info-input {
  color: #333;
  font-size: 28rpx;
  font-weight: bold;
  text-align: right;
  width: 50%;
  height: 60rpx;
}
.container .info-card .info-item .input-container .icon-wrapper {
  margin: 0 5rpx;
  padding: 5rpx;
}
.container .info-card .info-item .input-container .unit-text {
  color: #666;
  font-size: 28rpx;
  margin-left: 10rpx;
  white-space: nowrap;
}
.container .footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 999;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
}
.container .footer .save-btn {
  width: 90%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #007AFF;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  margin: 0 auto;
  padding: 0;
}
.container .footer .save-btn:active {
  opacity: 0.8;
}
.container .footer .save-btn::after {
  border: none;
}