.container {
  min-height: 100vh;
  background-color: #f5f6fa;
  padding: 20rpx;
}
.header {
  margin-bottom: 20rpx;
}
.header .add-building-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  color: #007AFF;
  font-size: 32rpx;
  border-radius: 8rpx;
  text-align: center;
}
.header .add-building-btn:active {
  opacity: 0.8;
}
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}
.footer .submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #007AFF;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
  transition: all 0.3s ease;
}
.footer .submit-btn:active {
  background: #0056b3;
  transform: scale(0.98);
}
.content .building-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.content .building-card .building-info {
  margin-bottom: 20rpx;
}
.content .building-card .building-info .building-name {
  font-size: 36rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}
.content .building-card .building-info .building-stats {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}
.content .building-card .building-info .progress-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.content .building-card .building-info .progress-wrapper .progress-bar {
  flex: 1;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}
.content .building-card .building-info .progress-wrapper .progress-bar .progress-inner {
  height: 100%;
  background: #007AFF;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}
.content .building-card .building-info .progress-wrapper .progress-text {
  font-size: 24rpx;
  color: #666;
  min-width: 60rpx;
  text-align: right;
}
.content .building-card .building-actions {
  display: flex;
  justify-content: flex-end;
}
.content .building-card .building-actions .action-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  color: #007AFF;
  font-size: 32rpx;
  border-radius: 8rpx;
  text-align: center;
}
.content .building-card .building-actions .action-btn:active {
  opacity: 0.8;
  background: #ebe2e2;
}
.area-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.area-popup .popup-content {
  width: 560rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}
.area-popup .popup-content .popup-title {
  font-size: 32rpx;
  color: #333;
  text-align: center;
  padding: 30rpx 0;
  font-weight: 500;
  border-bottom: 2rpx solid #f0f0f0;
}
.area-popup .popup-content .form-item {
  padding: 30rpx;
  display: flex;
  align-items: flex-start;
  border-bottom: 2rpx solid #f0f0f0;
  flex-direction: column;
}
.area-popup .popup-content .form-item .label {
  width: 100%;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}
.area-popup .popup-content .form-item .value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}
.area-popup .popup-content .form-item .area-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  border-bottom: 1rpx solid #746d6d;
}
.area-popup .popup-content .form-item .unit {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #666;
}
.area-popup .popup-content .popup-buttons {
  display: flex;
  padding: 20rpx;
}
.area-popup .popup-content .popup-buttons button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  margin: 0 10rpx;
}
.area-popup .popup-content .popup-buttons button.cancel-btn {
  background: #f5f5f5;
  color: #666;
}
.area-popup .popup-content .popup-buttons button.submit-btn {
  background: #007AFF;
  color: #fff;
}
.area-popup .popup-content .popup-buttons button:active {
  opacity: 0.8;
}