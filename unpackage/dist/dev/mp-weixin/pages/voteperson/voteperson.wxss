.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}
.form-section {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}
.form-section .form-item {
  padding: 24rpx 30rpx;
}
.form-section .form-item .label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}
.form-section .form-item .photo-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}
.form-section .form-item .input {
  width: 100%;
  height: 80rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}
.form-section .form-item .photo-upload {
  width: 200rpx;
  height: 200rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}
.form-section .form-item .photo-upload .photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.form-section .form-item .photo-upload .upload-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60rpx;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.form-section .form-item .photo-upload .upload-tip .iconfont {
  font-size: 28rpx;
  color: #fff;
}
.form-section .form-item .photo-upload .upload-tip text {
  font-size: 24rpx;
  color: #fff;
}
.form-section .form-item .description-box {
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
}
.form-section .form-item .description-box .description-tip {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}