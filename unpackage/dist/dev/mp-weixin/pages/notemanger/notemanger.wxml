<view class="container"><view class="action-bar"><button class="publish-btn" bindtap="{{a}}"><text class="iconfont icon-add"></text><text>+发布公告</text></button></view><view class="filter-bar"><picker mode="selector" range="{{c}}" bindchange="{{d}}"><view class="picker"><text>{{b}}</text><text class="iconfont icon-arrow-down"></text></view></picker><picker mode="selector" range="{{f}}" bindchange="{{g}}"><view class="picker"><text>{{e}}</text><text class="iconfont icon-arrow-down"></text></view></picker></view><view class="notice-list"><view wx:for="{{h}}" wx:for-item="item" wx:key="k" class="notice-item"><view class="notice-header"><text class="notice-title">{{item.a}}</text><text class="{{['notice-status', item.c]}}">{{item.b}}</text></view><view class="notice-info"><view class="info-item"><text class="label">公告类型：</text><text class="value">{{item.d}}</text></view><view class="info-item"><text class="label">发布时间：</text><text class="value">{{item.e}}</text></view><view class="info-item"><text class="label">阅读量：</text><text class="value">{{item.f}}</text></view></view><view class="notice-actions"><button class="action-btn edit" bindtap="{{item.g}}">编辑</button><button class="action-btn delete" bindtap="{{item.h}}">删除</button><button class="action-btn preview" bindtap="{{item.i}}">预览</button><button class="action-btn preview" bindtap="{{item.j}}">分享</button></view></view></view><view wx:if="{{i}}" class="empty-state"><image src="{{j}}" mode="aspectFit"></image><text>暂无公告</text></view></view>