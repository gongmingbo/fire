.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
.vote-section {
  background-color: #fff;
  padding: 10rpx 20rpx;
  margin-bottom: 20rpx;
}
.vote-section .section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.vote-section .section-header .section-left .section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}
.vote-section .section-header .section-right .section-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  background-color: #f8f8f8;
  border-radius: 6rpx;
}
.vote-section .section-header .section-right .section-value text {
  font-size: 28rpx;
  color: #333;
}
.form-section {
  background-color: #fff;
  padding: 20rpx 30rpx;
}
.form-item {
  margin-bottom: 30rpx;
}
.form-item .label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}
.form-item .label.required::before {
  content: "";
  margin-right: 0;
}
.form-item .input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
}
.form-item .options-list .option-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.form-item .options-list .option-item .option-index {
  width: 40rpx;
  height: 40rpx;
  background-color: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
}
.form-item .options-list .option-item .option-input {
  flex: 1;
  height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
}
.form-item .options-list .option-item .delete-btn {
  width: 80rpx;
  height: 40rpx;
  background-color: #f5f5f5;
  color: #ff4d4f;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  white-space: nowrap;
}
.form-item .options-list .add-option {
  height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #007AFF;
}
.form-item .options-list .add-option .iconfont {
  font-size: 32rpx;
}
.form-item .options-list .add-option text {
  font-size: 28rpx;
}
.form-item .picker {
  width: 100%;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 20rpx 30rpx;
}
.form-item .picker .label {
  margin-bottom: 20rpx;
}
.form-item .picker .time-range {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.form-item .picker .time-range .date {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #fff;
  border-radius: 6rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}
.form-item .picker .time-range .separator {
  color: #999;
  font-size: 28rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.footer .btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.footer .btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}
.footer .btn.confirm {
  background-color: #007AFF;
  color: #fff;
}