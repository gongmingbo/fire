.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}
.top-section {
  background-color: #007AFF;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.header {
  padding: 30rpx;
}
.header .title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}
.description {
  padding: 0 30rpx 30rpx;
}
.description text {
  color: #fff;
  font-size: 28rpx;
  line-height: 1.5;
}
.convention {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}
.convention text {
  color: #fff;
  font-size: 28rpx;
}
.moment-list .moment-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.moment-list .moment-item .user-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.moment-list .moment-item .user-info .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.moment-list .moment-item .user-info .info {
  flex: 1;
}
.moment-list .moment-item .user-info .info .name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}
.moment-list .moment-item .user-info .info .time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.moment-list .moment-item .content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.moment-list .moment-item .image-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -4rpx 16rpx;
}
.moment-list .moment-item .image-list image {
  width: calc(33.33% - 8rpx);
  height: 200rpx;
  margin: 4rpx;
  border-radius: 8rpx;
}
.moment-list .moment-item .action-bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.moment-list .moment-item .action-bar .action-item {
  display: flex;
  align-items: center;
  margin-left: 30rpx;
}
.moment-list .moment-item .action-bar .action-item text {
  font-size: 26rpx;
  color: #999;
  margin-left: 8rpx;
}
.moment-list .moment-item .action-bar .action-item .like-count.liked {
  color: #ff4d4f;
}
.add-show {
  position: fixed;
  bottom: calc(20rpx + env(safe-area-inset-bottom) + 100rpx);
  right: 30rpx;
  background-color: #007AFF;
  z-index: 100000;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
  transition: all 0.3s ease;
  opacity: 0.5;
}
.add-show:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(0, 122, 255, 0.2);
}
.add-show .uni-icons {
  color: #fff !important;
  font-size: 60rpx !important;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}
.notice-image {
  display: flex;
  padding: 20rpx 30rpx;
  background-color: rgba(255, 255, 255, 0.1);
  margin-top: 20rpx;
}
.notice-image .image-item {
  flex: 1;
  margin: 0 10rpx;
  border-radius: 8rpx;
  overflow: hidden;
}
.notice-image .image-item:first-child {
  margin-left: 0;
}
.notice-image .image-item:last-child {
  margin-right: 0;
}
.notice-image .image-item image {
  width: 100%;
  display: block;
}