.container {
  min-height: 100vh;
  background-color: #f5f6fa;
  padding: 30rpx;
}
.record-list .record-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.record-list .record-item .record-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f1f5;
}
.record-list .record-item .record-header .house-info .house-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
  display: block;
}
.record-list .record-item .record-header .house-info .house-area {
  font-size: 26rpx;
  color: #666;
  display: block;
}
.record-list .record-item .record-header .status-tag {
  padding: 6rpx 20rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
}
.record-list .record-item .record-header .status-tag.pending {
  background: #e6f7ff;
  color: #1890ff;
}
.record-list .record-item .record-header .status-tag.approved {
  background: #f6ffed;
  color: #52c41a;
}
.record-list .record-item .record-header .status-tag.rejected {
  background: #fff1f0;
  color: #ff4d4f;
}
.record-list .record-item .record-content .info-row {
  display: flex;
  margin-bottom: 16rpx;
}
.record-list .record-item .record-content .info-row:last-child {
  margin-bottom: 0;
}
.record-list .record-item .record-content .info-row .label {
  font-size: 26rpx;
  color: #666;
  width: 140rpx;
  flex-shrink: 0;
}
.record-list .record-item .record-content .info-row .value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}
.record-list .record-item .record-content .certificate-images {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f1f5;
}
.record-list .record-item .record-content .certificate-images .section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
  display: block;
}
.record-list .record-item .record-content .certificate-images .image-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}
.record-list .record-item .record-content .certificate-images .image-list .image-item {
  width: calc(33.33% - 20rpx);
  margin: 10rpx;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.record-list .record-item .record-content .certificate-images .image-list .image-item::after {
  content: "";
  display: block;
  padding-bottom: 100%;
}
.record-list .record-item .record-content .certificate-images .image-list .image-item image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}
.record-list .record-item .record-content .certificate-images .image-list .image-item:active image {
  transform: scale(0.95);
}
.record-list .record-item .record-footer {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f1f5;
}
.record-list .record-item .record-footer .reapply-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: #fff;
  color: #007AFF;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: 2rpx solid #007AFF;
  transition: all 0.3s ease;
}
.record-list .record-item .record-footer .reapply-btn:active {
  background: #f0f7ff;
  transform: scale(0.98);
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.empty-state image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
}
.empty-state text {
  font-size: 28rpx;
  color: #999;
}