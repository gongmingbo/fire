<view class="container"><view class="building-list"><view wx:for="{{a}}" wx:for-item="building" wx:key="f" class="building-item"><view class="building-header" bindtap="{{building.c}}"><text class="building-title">{{building.a}}</text><text class="collapse-btn">{{building.b}}</text></view><view class="room-list" hidden="{{!building.e}}"><view wx:for="{{building.d}}" wx:for-item="room" wx:key="d" class="room-item"><text class="room-name">{{room.a}}</text><label class="checkbox-wrapper"><checkbox checked="{{room.b}}" bindtap="{{room.c}}"></checkbox></label></view></view></view></view><view class="footer"><view class="selected-count"><text>已选{{b}}个</text></view><view class="confirm-btn"><button bindtap="{{c}}">确定</button></view></view></view>