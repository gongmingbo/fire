.container {
  min-height: 100vh;
  background-color: #f5f6fa;
  padding: 30rpx;
  padding-bottom: 120rpx;
}
.header {
  background: linear-gradient(135deg, #007AFF, #0056b3);
  padding: 40rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}
.header .title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}
.header .subtitle {
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
}
.search-box {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
}
.search-box .search-input {
  flex: 1;
  height: 72rpx;
  background: #f8f9fc;
  border-radius: 8rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
}
.search-box .search-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #007AFF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  margin-left: 20rpx;
  text-align: center;
  transition: all 0.3s ease;
}
.search-box .search-btn:active {
  transform: scale(0.98);
  background: #0056b3;
}
.house-list .house-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}
.house-list .house-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.05);
}
.house-list .house-item .house-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.house-list .house-item .house-info {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.house-list .house-item .house-info .info-item {
  font-size: 26rpx;
  color: #666;
  margin-right: 30rpx;
  display: flex;
  align-items: center;
}
.house-list .house-item .house-info .info-item .icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}
.house-list .house-item .house-address {
  font-size: 26rpx;
  color: #999;
  display: flex;
  align-items: center;
}
.house-list .house-item .house-address .icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.empty-state .empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}
.empty-state .empty-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
}
.page-enter-active,
.page-leave-active {
  transition: opacity 0.3s ease;
}
.page-enter-from,
.page-leave-to {
  opacity: 0;
}
.building-list .building-item {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}
.building-list .building-item .building-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #f8f9fc;
  border-bottom: 2rpx solid #f0f1f5;
  cursor: pointer;
  transition: background-color 0.3s ease;
}
.building-list .building-item .building-header:active {
  background-color: #f0f1f5;
}
.building-list .building-item .building-header .building-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}
.building-list .building-item .building-header .collapse-btn {
  font-size: 28rpx;
  color: #007AFF;
  padding: 8rpx 20rpx;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 6rpx;
  transition: all 0.3s ease;
}
.building-list .building-item .building-header .collapse-btn:active {
  background: rgba(0, 122, 255, 0.2);
}
.building-list .building-item .room-list {
  transition: all 0.3s ease;
  overflow: hidden;
}
.building-list .building-item .room-list .room-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 2rpx solid #f0f1f5;
}
.building-list .building-item .room-list .room-item:last-child {
  border-bottom: none;
}
.building-list .building-item .room-list .room-item .room-name {
  font-size: 28rpx;
  color: #666;
  flex: 1;
  margin-right: 20rpx;
}
.building-list .building-item .room-list .room-item .checkbox-wrapper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 60rpx;
}
.building-list .building-item .room-list .room-item .checkbox-wrapper checkbox {
  transform: scale(0.8);
}
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}
.footer .selected-count {
  flex: 1;
}
.footer .selected-count text {
  font-size: 28rpx;
  color: #666;
}
.footer .confirm-btn {
  flex: 2;
  margin-left: 30rpx;
}
.footer .confirm-btn button {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #007AFF;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
  transition: all 0.3s ease;
}
.footer .confirm-btn button:active {
  background: #0056b3;
  transform: scale(0.98);
}