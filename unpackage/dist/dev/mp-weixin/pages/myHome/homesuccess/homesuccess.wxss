.container {
  min-height: 100vh;
  background-color: #f5f6fa;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.success-content {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.success-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
  animation: scaleIn 0.5s ease-out;
}
.success-icon image {
  width: 100%;
  height: 100%;
}
.success-text {
  text-align: center;
  margin-bottom: 60rpx;
}
.success-text .title {
  font-size: 40rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
}
.success-text .subtitle {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  display: block;
}
.tips-box {
  width: 100%;
  background: #f8f9fc;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 60rpx;
}
.tips-box .tip-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.tips-box .tip-item:last-child {
  margin-bottom: 0;
}
.tips-box .tip-item .dot {
  width: 12rpx;
  height: 12rpx;
  background: #007AFF;
  border-radius: 50%;
  margin-right: 16rpx;
}
.tips-box .tip-item .text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.button-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.button-group .primary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #007AFF;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
  transition: all 0.3s ease;
}
.button-group .primary-btn:active {
  background: #0056b3;
  transform: scale(0.98);
}
.button-group .secondary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #007AFF;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid #007AFF;
  transition: all 0.3s ease;
}
.button-group .secondary-btn:active {
  background: #f0f7ff;
  transform: scale(0.98);
}
@keyframes scaleIn {
0% {
    transform: scale(0.5);
    opacity: 0;
}
100% {
    transform: scale(1);
    opacity: 1;
}
}