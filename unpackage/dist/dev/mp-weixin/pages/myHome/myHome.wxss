.container {
  min-height: 100vh;
  background-color: #f5f6fa;
  padding-bottom: 120rpx;
  position: relative;
}
.content {
  padding: 30rpx;
  background-color: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.content text {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}
.content .action-btn {
  background-color: #007AFF;
  color: #fff;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.footer .footer-btn {
  width: 45%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
  transition: all 0.3s ease;
}
.footer .footer-btn:active {
  transform: scale(0.98);
}
.footer .footer-btn.bind-btn {
  background-color: #007AFF;
  color: #fff;
}
.footer .footer-btn.record-btn {
  background-color: #f8f9fc;
  color: #333;
  border: 2rpx solid #e5e6eb;
}
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
}
.action-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  z-index: 999;
  width: 560rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}
.action-popup .popup-title {
  font-size: 32rpx;
  color: #333;
  text-align: center;
  padding: 30rpx 0;
  font-weight: 500;
  border-bottom: 2rpx solid #f0f0f0;
}
.action-popup .action-list {
  padding: 20rpx 0;
}
.action-popup .action-list .action-item {
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.action-popup .action-list .action-item:active {
  background: #f5f5f5;
}
.action-popup .action-list .action-item::after {
  content: "";
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 0;
  height: 1rpx;
  background: #f0f0f0;
}
.action-popup .action-list .action-item:last-child::after {
  display: none;
}
.action-popup .action-list .action-item .action-text {
  font-size: 32rpx;
  color: #333;
}
.action-popup .action-list .action-item.cancel {
  margin-top: 20rpx;
  background: #f5f5f5;
}
.action-popup .action-list .action-item.cancel .action-text {
  color: #666;
}
.area-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.area-popup .popup-content {
  width: 560rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}
.area-popup .popup-content .popup-title {
  font-size: 32rpx;
  color: #333;
  text-align: center;
  padding: 30rpx 0;
  font-weight: 500;
  border-bottom: 2rpx solid #f0f0f0;
}
.area-popup .popup-content .form-item {
  padding: 30rpx;
  display: flex;
  align-items: flex-start;
  border-bottom: 2rpx solid #f0f0f0;
  flex-direction: column;
}
.area-popup .popup-content .form-item .label {
  width: 100%;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}
.area-popup .popup-content .form-item .value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}
.area-popup .popup-content .form-item .area-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
  border-bottom: 1rpx solid #746d6d;
}
.area-popup .popup-content .form-item .unit {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #666;
}
.area-popup .popup-content .popup-buttons {
  display: flex;
  padding: 20rpx;
}
.area-popup .popup-content .popup-buttons button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  margin: 0 10rpx;
}
.area-popup .popup-content .popup-buttons button.cancel-btn {
  background: #f5f5f5;
  color: #666;
}
.area-popup .popup-content .popup-buttons button.submit-btn {
  background: #007AFF;
  color: #fff;
}
.area-popup .popup-content .popup-buttons button:active {
  opacity: 0.8;
}