<view class="container"><view class="header"><button class="{{['filter-btn', a && 'active']}}" bindtap="{{b}}">未审核</button><button class="{{['filter-btn', c && 'active']}}" bindtap="{{d}}">已审核</button></view><view class="content" bindtap="{{h}}"><view wx:for="{{e}}" wx:for-item="item" wx:key="i" class="audit-item"><view class="item-header"><text class="building-name">{{item.a}}</text><text wx:if="{{f}}" class="{{['status', item.c && 'pass', item.d && 'reject']}}">{{item.b}}</text></view><view class="item-content"><view class="info-row"><text class="label">申请人：</text><text class="value">{{item.e}}</text></view><view class="info-row"><text class="label">申请时间：</text><text class="value">{{item.f}}</text></view><view class="info-row"><text class="label">联系电话：</text><text class="value">{{item.g}}</text></view></view><view wx:if="{{g}}" class="item-footer"><button class="action-btn approve" bindtap="{{item.h}}">审批</button></view></view></view></view>