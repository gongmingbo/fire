.container {
  min-height: 100vh;
  background-color: #f5f6fa;
  padding: 20rpx;
  padding-bottom: 140rpx;
}
.content .header {
  padding: 20rpx;
  background: yellow;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
}
.content .header .title {
  font-size: 36rpx;
  color: #333;
  font-weight: 500;
}
.content .info-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.content .info-card:last-child {
  margin-bottom: 0;
}
.content .info-card .header {
  padding: 20rpx;
  background: yellow;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
}
.content .info-card .header .title {
  font-size: 36rpx;
  color: #333;
  font-weight: 500;
}
.content .info-card .card-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
}
.content .info-card .info-list .info-item {
  display: flex;
  margin-bottom: 16rpx;
}
.content .info-card .info-list .info-item:last-child {
  margin-bottom: 0;
}
.content .info-card .info-list .info-item .label {
  font-size: 28rpx;
  color: #666;
  width: 140rpx;
}
.content .info-card .info-list .info-item .value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}
.content .info-card .material-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.content .info-card .material-list .material-item {
  width: calc(50% - 10rpx);
}
.content .info-card .material-list .material-item .material-image {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}
.content .info-card .material-list .material-item .material-name {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  display: block;
  text-align: center;
}
.content .info-card .remark-box {
  position: relative;
}
.content .info-card .remark-box .remark-input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
  border-radius: 8rpx;
  box-sizing: border-box;
  text-align: left;
  line-height: 1.5;
}
.content .info-card .remark-box .remark-input::-webkit-input-placeholder {
  color: #999;
}
.content .info-card .remark-box .remark-input::placeholder {
  color: #999;
}
.content .info-card .remark-box .word-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  color: #999;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 20rpx;
}
.footer .action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
}
.footer .action-btn.reject {
  color: #FF3B30;
  background: #fff;
  border: 2rpx solid #FF3B30;
}
.footer .action-btn.approve {
  color: #fff;
  background: #007AFF;
  border: 2rpx solid #007AFF;
}
.footer .action-btn:active {
  opacity: 0.8;
}