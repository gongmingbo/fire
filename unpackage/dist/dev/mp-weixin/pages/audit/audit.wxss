.container {
  min-height: 100vh;
  background-color: #f5f6fa;
  padding: 20rpx;
}
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.header .filter-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #007AFF;
  background: #fff;
  border: 2rpx solid #007AFF;
  width: 50%;
}
.header .filter-btn.active {
  color: #fff;
  background: #007AFF;
}
.header .filter-btn:active {
  opacity: 0.8;
}
.content .audit-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.content .audit-item:last-child {
  margin-bottom: 0;
}
.content .audit-item .item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.content .audit-item .item-header .building-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}
.content .audit-item .item-header .status {
  font-size: 28rpx;
  color: #007AFF;
  padding: 10rpx;
  border-radius: 10%;
}
.content .audit-item .item-header .pass {
  background-color: lightgreen;
  color: white;
}
.content .audit-item .item-header .reject {
  background-color: red;
  color: white;
}
.content .audit-item .item-content .info-row {
  display: flex;
  margin-bottom: 16rpx;
}
.content .audit-item .item-content .info-row:last-child {
  margin-bottom: 0;
}
.content .audit-item .item-content .info-row .label {
  font-size: 28rpx;
  color: #666;
  width: 140rpx;
}
.content .audit-item .item-content .info-row .value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}
.content .audit-item .item-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 30rpx;
}
.content .audit-item .item-footer .action-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  border-radius: 36rpx;
  width: 100%;
}
.content .audit-item .item-footer .action-btn.approve {
  color: #fff;
  background: #007AFF;
  border: 2rpx solid #007AFF;
}
.content .audit-item .item-footer .action-btn:active {
  opacity: 0.8;
}