.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
.form-section {
  background-color: #fff;
  padding: 20rpx 30rpx;
}
.form-item {
  margin-bottom: 30rpx;
  padding-right: 30rpx;
}
.form-item .label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}
.form-item .label.required::before {
  content: "";
  margin-right: 0;
}
.form-item .value {
  font-size: 28rpx;
  color: #666;
}
.form-item .sub-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 15rpx;
  display: block;
}
.form-item .input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
}
.form-item .textarea {
  width: 100%;
  height: 300rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #333;
}
.form-item .word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}
.form-item .picker {
  width: 100%;
  height: 80rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
}
.form-item .picker .label {
  margin-bottom: 0;
  color: #333;
}
.form-item .picker .right-content {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.form-item .picker .right-content .value {
  color: #666;
}
.form-item .picker .right-content .iconfont {
  color: #999;
  font-size: 24rpx;
}
.upload-area .image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.upload-area .image-list .image-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
}
.upload-area .image-list .image-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.upload-area .image-list .image-item .delete-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.upload-area .image-list .upload-btn {
  width: 200rpx;
  height: 200rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}
.upload-area .image-list .upload-btn .iconfont {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}
.upload-area .image-list .upload-btn text {
  font-size: 24rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.footer .btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.footer .btn.draft {
  background-color: #f5f5f5;
  color: #666;
}
.footer .btn.preview {
  background-color: #E3F2FD;
  color: #2196F3;
}
.footer .btn.publish {
  background-color: #007AFF;
  color: #fff;
}
.preview-popup {
  display: none;
}