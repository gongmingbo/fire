.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
.content-input {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.content-input textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
.content-input .word-count {
  font-size: 24rpx;
  color: #999;
  text-align: right;
  display: block;
  margin-top: 10rpx;
}
.image-upload {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.image-upload .image-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -4rpx;
}
.image-upload .image-list .image-item {
  position: relative;
  width: calc(33.33% - 8rpx);
  height: 200rpx;
  margin: 4rpx;
}
.image-upload .image-list .image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.image-upload .image-list .image-item .delete-btn {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.image-upload .image-list .upload-btn {
  width: calc(33.33% - 8rpx);
  height: 200rpx;
  margin: 4rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.image-upload .image-list .upload-btn .upload-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}
.image-upload .upload-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 999;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.bottom-bar .location {
  display: flex;
  align-items: center;
}
.bottom-bar .location text {
  font-size: 28rpx;
  color: #666;
  margin-left: 8rpx;
}
.bottom-bar .submit-btn {
  width: 160rpx;
  height: 72rpx;
  line-height: 72rpx;
  background-color: #007AFF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
}
.bottom-bar .submit-btn[disabled] {
  background-color: #ccc;
}