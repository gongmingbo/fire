.container {
  min-height: 100vh;
  background-color: #fff;
  padding: 30rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
.notice-title {
  margin-bottom: 20rpx;
}
.notice-title text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}
.notice-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}
.notice-info text {
  font-size: 24rpx;
  color: #999;
}
.notice-content .content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-line;
  margin-bottom: 30rpx;
}
.notice-content .notice-image {
  margin: 20rpx 0;
}
.notice-content .notice-image .image-row {
  display: flex;
  margin-bottom: 20rpx;
}
.notice-content .notice-image .image-row:last-child {
  margin-bottom: 0;
}
.notice-content .notice-image .image-row .image-item {
  flex: 1;
  margin-right: 20rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}
.notice-content .notice-image .image-row .image-item:last-child {
  margin-right: 0;
}
.notice-content .notice-image .image-row .image-item image {
  width: 100%;
  height: 200rpx;
  display: block;
}
.countdown-section {
  background-color: #FFF9C4;
  padding: 20rpx;
  border-radius: 8rpx;
  margin: 30rpx 0;
  text-align: center;
}
.countdown-section text {
  font-size: 28rpx;
  color: #333;
}
.countdown-section text.countdown {
  font-weight: bold;
  margin-left: 10rpx;
}
.vote-section {
  margin: 30rpx 0;
}
.vote-section .vote-section-title {
  display: flex;
  justify-content: space-between;
  padding: 20rpx;
}
.vote-section .vote-section-title .vote-mark {
  color: #007AFF;
}
.vote-section .vote-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}
.vote-section .vote-option {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
}
.vote-section .vote-option text {
  font-size: 28rpx;
  color: #333;
  margin-left: 10rpx;
}
.vote-section .vote-option .vote-option-image {
  width: 50rpx;
  height: 30rpx;
}
.vote-section .vote-option .vote-option-image-detail {
  position: absolute;
  right: 0;
  color: #007AFF;
  font-size: 28rpx;
}
.signature-section {
  margin: 30rpx 0;
}
.signature-section .signature-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}
.signature-section .signature-canvas {
  width: 100%;
  height: 400rpx;
  background-color: #fff;
  border: 1px solid #ddd;
  border-radius: 8rpx;
}
.signature-section .signature-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}
.signature-section .signature-actions button {
  width: 45%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
}
.signature-section .signature-actions button:first-child {
  background-color: #f5f5f5;
  color: #666;
}
.signature-section .signature-actions button:last-child {
  background-color: #007AFF;
  color: #fff;
}
.vote-ended .vote-ended-tip {
  background-color: #FFF9C4;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
  margin: 30rpx 0;
}
.vote-ended .vote-ended-tip text {
  font-size: 28rpx;
  color: #FF9800;
  font-weight: bold;
}
.vote-ended .vote-result {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}
.vote-ended .vote-result .result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
}
.vote-ended .vote-result .result-item:last-child {
  margin-bottom: 0;
}
.vote-ended .vote-result .result-item .option {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.vote-ended .vote-result .result-item .stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.vote-ended .vote-result .result-item .stats text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
.vote-ended .vote-result .result-item .stats text:first-child {
  margin-bottom: 8rpx;
}
.vote-ended .vote-analysis {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
}
.vote-ended .vote-analysis .title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
  display: block;
}
.vote-ended .vote-analysis .content {
  font-size: 26rpx;
  color: blue;
  margin-bottom: 20rpx;
  display: block;
}
.vote-ended .vote-analysis .analysis-item {
  margin-bottom: 10rpx;
}
.vote-ended .vote-analysis .analysis-item text {
  font-size: 26rpx;
  color: #666;
}
.vote-remark-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.vote-remark-popup .popup-content {
  width: 90%;
  max-height: 90vh;
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.vote-remark-popup .popup-content .popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.vote-remark-popup .popup-content .popup-header .popup-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}
.vote-remark-popup .popup-content .popup-header .close-btn {
  font-size: 40rpx;
  color: #999;
  padding: 0 20rpx;
}
.vote-remark-popup .popup-content .popup-body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
}
.vote-mark {
  color: #007AFF;
  cursor: pointer;
}
.candidate-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.candidate-popup .candidate-content {
  width: 90%;
  max-height: 90vh;
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.candidate-popup .candidate-content .candidate-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.candidate-popup .candidate-content .candidate-header .candidate-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}
.candidate-popup .candidate-content .candidate-header .close-btn {
  font-size: 40rpx;
  color: #999;
  padding: 0 20rpx;
}
.candidate-popup .candidate-content .candidate-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}
.candidate-popup .candidate-content .candidate-body .candidate-image-section {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}
.candidate-popup .candidate-content .candidate-body .candidate-image-section .candidate-image {
  width: 200rpx;
  height: 200rpx;
  object-fit: cover;
}
.candidate-popup .candidate-content .candidate-body .candidate-button {
  background-color: #007AFF;
  color: #fff;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  transition: all 0.3s ease;
}
.candidate-popup .candidate-content .candidate-body .candidate-button.button-hover {
  background-color: #0056b3;
  transform: scale(0.98);
}
.candidate-popup .candidate-content .candidate-body .candidate-name-section {
  text-align: center;
  margin-bottom: 30rpx;
}
.candidate-popup .candidate-content .candidate-body .candidate-name-section .candidate-name {
  font-size: 36rpx;
  color: #333;
  font-weight: 500;
}
.candidate-popup .candidate-content .candidate-body .candidate-intro-section {
  text-align: center;
}
.candidate-popup .candidate-content .candidate-body .candidate-intro-section .candidate-intro {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}