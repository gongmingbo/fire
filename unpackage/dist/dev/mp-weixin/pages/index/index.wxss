.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}
.header {
  display: flex;
  align-items: center;
  padding: 20rpx;
}
.header .community-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 10rpx;
}
.community-stats {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin: 20rpx 20rpx;
  display: flex;
  justify-content: space-around;
}
.community-stats .stat-item {
  text-align: center;
  padding: 0 20rpx;
  border-right: 1rpx solid rgba(128, 128, 128, 0.2);
}
.community-stats .stat-item:last-child {
  border-right: none;
}
.community-stats .stat-item .stat-label {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
  font-weight: 600;
}
.community-stats .stat-item .stat-value {
  font-size: 24rpx;
  font-weight: 500;
  margin-top: 10rpx;
  white-space: nowrap;
}
.neighbor-section {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin: 20rpx 20rpx;
}
.neighbor-section .neighbor-avatars {
  position: relative;
  height: 60rpx;
}
.neighbor-section .neighbor-avatars .avatar {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  overflow: hidden;
}
.neighbor-section .neighbor-avatars .avatar:nth-child(1) {
  left: 0;
  z-index: 3;
}
.neighbor-section .neighbor-avatars .avatar:nth-child(2) {
  left: 40rpx;
  z-index: 2;
}
.neighbor-section .neighbor-avatars .avatar:nth-child(3) {
  left: 80rpx;
  z-index: 1;
}
.neighbor-section .neighbor-avatars .avatar image {
  width: 100%;
  height: 100%;
}
.neighbor-section .neighbor-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.neighbor-section .neighbor-info .neighbor-count {
  color: #666;
  font-size: 26rpx;
}
.neighbor-section .neighbor-info .neighbor-more {
  color: #007AFF;
  font-size: 26rpx;
}
.feature-nav {
  display: flex;
  justify-content: space-around;
  margin: 30rpx 20rpx;
}
.feature-nav .feature-item {
  width: 160rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  border-radius: 10rpx;
  font-size: 28rpx;
}
.notice-list {
  margin: 20rpx 0;
}
.notice-list .notice-item {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin: 20rpx 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.notice-list .notice-item .notice-header {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.notice-list .notice-item .notice-header .notice-type {
  display: flex;
  align-items: center;
}
.notice-list .notice-item .notice-header .notice-type .notice-status {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 20rpx;
  font-size: 24rpx;
}
.notice-list .notice-item .notice-header .notice-type .notice-status.read {
  color: #666;
  border: 1rpx solid #666;
}
.notice-list .notice-item .notice-header .notice-type .notice-status.unread {
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
}
.notice-list .notice-item .notice-content {
  padding: 20rpx;
}
.notice-list .notice-item .notice-content .notice-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}
.notice-list .notice-item .notice-content .notice-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.notice-list .notice-item .notice-action {
  text-align: center;
  padding: 20rpx;
  color: #007AFF;
  border-top: 1rpx solid #f0f0f0;
}
.dropdown-container {
  position: relative;
  cursor: pointer;
}
.dropdown-container .dropdown-menu {
  position: absolute;
  top: 100%;
  right: 0;
  background-color: #fff;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  min-width: 200rpx;
  margin-top: 10rpx;
}
.dropdown-container .dropdown-menu .dropdown-item {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  transition: background-color 0.3s;
}
.dropdown-container .dropdown-menu .dropdown-item:hover {
  background-color: #f5f5f5;
}
.dropdown-container .dropdown-menu .dropdown-item:not(:last-child) {
  border-bottom: 1rpx solid #f0f0f0;
}