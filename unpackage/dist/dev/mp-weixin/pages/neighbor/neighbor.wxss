.main {
  padding-bottom: 100rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}
.header {
  padding: 20rpx;
  background-color: white;
}
.header .search-bar {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
}
.header .search-bar input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
}
.content {
  margin: 20rpx;
  padding: 20rpx;
  background-color: white;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.content:last-child {
  margin-bottom: 100rpx;
}
.content .content-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}
.content .content-header .header-info {
  display: flex;
  flex-direction: column;
}
.content .content-header .header-info .community-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.content .content-header .header-info .auth-progress {
  font-size: 24rpx;
  color: #666;
}
.content .loading, .content .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  color: #999;
}
.content .loading text, .content .empty-state text {
  margin-top: 16rpx;
  font-size: 28rpx;
}
.content .room-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
  transition: background-color 0.3s;
}
.content .room-item:active {
  background-color: #f5f5f5;
}
.content .room-item.last-item {
  border-bottom: none;
}
.content .room-item .room-name {
  flex: 3;
  font-size: 28rpx;
  color: #444;
}
.content .room-item .auth-status {
  flex: 1;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 24rpx;
  margin-left: 20rpx;
}
.content .room-item .auth-status.authenticated {
  background: #ff4444;
  color: white;
  border: 1rpx solid #ff4444;
}
.content .room-item .auth-status.unauthenticated {
  background: #f5f5f5;
  color: #666;
  border: 1rpx solid #ddd;
}
.content .room-item .user-name {
  flex: 2;
  text-align: right;
  font-size: 26rpx;
  color: #666;
}
.footer {
  position: fixed;
  bottom: 0;
  width: 100%;
  background: white;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.footer .invite-button {
  background: #007AFF;
  color: white;
  padding: 16rpx 0;
  font-size: 28rpx;
  transition: all 0.3s;
}
.footer .invite-button:active {
  opacity: 0.8;
  transform: scale(0.98);
}